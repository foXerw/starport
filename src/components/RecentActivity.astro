---
import { formatDate } from '../lib/essays';
import type { CollectionEntry } from 'astro:content';
interface Props { essays: CollectionEntry<'essays'>[] }
const { essays } = Astro.props;
---
<section class="max-w-3xl mx-auto px-6 py-8">
  <h2 class="mb-3 flex items-center gap-2 text-xs tracking-[0.25em] text-dusk-300">
    <span class="text-lamp" aria-hidden="true">✦</span>最新动态
  </h2>
  {essays.length === 0
    ? <p class="text-sm text-dusk-300">港里还很安静。</p>
    : (
        <ul class="space-y-2">
          {essays.map((e) => (
            <li class="flex justify-between gap-3 text-sm">
              <a href={`/essays/${e.id}/`} class="text-foam-dim hover:text-lamp transition-colors">{e.data.title}</a>
              <time datetime={formatDate(e.data.date)} class="text-dusk-300">{formatDate(e.data.date)}</time>
            </li>
          ))}
        </ul>
      )}
</section>
